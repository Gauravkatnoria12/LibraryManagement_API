# pyenv
#   For a library or package, you might want to ignore these files since the user is
#   creating multiple environments inside the same directory.
.python-version

# pipenv
#   According to pypa/pipenv#1255, pipenv should ignore the virtualenv.
#   For a project utilizing pipenv, Pipfile.lock contains the state.
#   So you should not ignore Pipfile.lock.
#   But you should ignore the virtualenv.
#   In case of .venv path:
.venv/
venv/
ENV/
env/
ENV/local/
ENV/lib/

# Poetry
#   Poetry creates its own virtual environments in a standard cache directory
#   so you don't need to ignore it here, but in case you configure it to create
#   virtual environment inside the project, you should ignore it:
.poetry/

# pdm
#   PDM stores project-wide configurations in .pdm.toml
.pdm.toml
#   and toml files in the .pdm-plugins/ directory
.pdm-plugins/
#   and local packages in the __pypackages__/ directory
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

